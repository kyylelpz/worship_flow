rules_version = '2';
// Spark schema: private profiles; opt-in emailDirectory/{lowercaseEmail}: uid only;
// directoryAccess/{uid}: groupId proving current admin authority (never a role).
// groups: immutable name/churchName/createdBy/memberCount/accentColorValue/createdAt;
// administratorUid is a witness to an actual surviving Administrator, not authority.
// members: uid/groupId/name snapshots, role, independent position, timestamps.
// owner memberships: uid/groupId/createdAt/updatedAt, atomically mirrors member.
// profiles/{recipient}/invitations/{group}: immutable assignment/groupName/inviterUid,
// notificationId, createdAt; status pending|accepted|declined, updatedAt.
// profiles/{inviter}/notifications/{id}: recipientUid/groupId/groupName/createdAt/readAt.
// Legacy codes, server quotas, Song/Setlist paths remain denied. No Functions required.
service cloud.firestore {
 match /databases/{database}/documents {
  function google() {
   return request.auth != null && request.auth.token.email_verified == true
    && request.auth.token.firebase.sign_in_provider == 'google.com';
  }
  function owner(uid) { return google() && request.auth.uid == uid; }
  function profile(uid) { return get(/databases/$(database)/documents/profiles/$(uid)).data; }
  function complete() { return google() && profile(request.auth.uid).profileComplete == true; }
  function memberPath(g,u) { return /databases/$(database)/documents/groups/$(g)/members/$(u); }
  function groupPath(g) { return /databases/$(database)/documents/groups/$(g); }
  function indexPath(g,u) { return /databases/$(database)/documents/profiles/$(u)/memberships/$(g); }
  function invitationPath(g,u) { return /databases/$(database)/documents/profiles/$(u)/invitations/$(g); }
  function admin(g,u) { return exists(groupPath(g)) && get(memberPath(g,u)).data.role == 'administrator'; }
  function member(g) { return complete() && exists(groupPath(g)) && exists(memberPath(g,request.auth.uid)); }
  function text(s,n) { return s is string && s.size() > 0 && s.size() <= n && !s.matches('.*[\\x00-\\x1f\\x7f].*'); }
  function validPosition(d) {
   return d.position in ['vocalist','acousticGuitar','electricGuitar','bassGuitar','keyboard','drums','other']
    && d.customPosition is string && (d.position == 'other' ? text(d.customPosition,80) : d.customPosition == '');
  }
  function validRole(d) { return d.role in ['administrator','worshipLeader','worshipTrainee']; }
  function validProfile(d) {
   return d.keys().hasAll(['firstName','lastName','email','profileComplete','createdAt','updatedAt','completedAt','allowInvitations'])
    && d.keys().hasOnly(['firstName','lastName','email','profileComplete','createdAt','updatedAt','completedAt','allowInvitations'])
    && d.firstName is string && d.firstName.size() <= 80 && d.lastName is string && d.lastName.size() <= 80
    && d.email == request.auth.token.email && text(d.email,320)
    && d.profileComplete is bool && d.allowInvitations is bool
    && d.createdAt is timestamp && d.updatedAt == request.time
    && (d.profileComplete ? text(d.firstName,80) && text(d.lastName,80) && d.completedAt is timestamp : d.completedAt == null && d.allowInvitations == false);
  }
  function directoryMatches(uid,d) {
   let p = getAfter(/databases/$(database)/documents/profiles/$(uid)).data;
   return p.allowInvitations == true && p.profileComplete == true && d.uid == uid;
  }
  function validDirectory(uid,d) {
   return d.keys().hasAll(['uid']) && d.keys().hasOnly(['uid']) && d.uid == uid;
  }
  function validLookupContext(uid,d) {
   return d.keys().hasAll(['groupId']) && d.keys().hasOnly(['groupId'])
    && text(d.groupId,128) && admin(d.groupId,uid);
  }
  function profileDirectory(d) {
   let path = /databases/$(database)/documents/emailDirectory/$(d.email.lower());
   return d.allowInvitations ? getAfter(path).data.uid == request.auth.uid : !existsAfter(path);
  }
  function validGroup(d) {
   return d.keys().hasAll(['name','churchName','createdBy','memberCount','accentColorValue','createdAt','updatedAt','administratorUid'])
    && d.keys().hasOnly(['name','churchName','createdBy','memberCount','accentColorValue','createdAt','updatedAt','administratorUid'])
    && text(d.name,120) && text(d.churchName,160) && text(d.createdBy,128)
    && d.memberCount is int && d.memberCount >= 1 && d.accentColorValue is int
    && d.createdAt is timestamp && d.updatedAt == request.time && text(d.administratorUid,128);
  }
  function survivingAdmin(g) {
   let d = getAfter(groupPath(g)).data;
   return getAfter(memberPath(g,d.administratorUid)).data.role == 'administrator';
  }
  function validMember(g,u,d) {
   return d.keys().hasAll(['uid','groupId','firstName','lastName','role','position','customPosition','createdAt','updatedAt'])
    && d.keys().hasOnly(['uid','groupId','firstName','lastName','role','position','customPosition','createdAt','updatedAt'])
    && d.uid == u && d.groupId == g && text(d.firstName,80) && text(d.lastName,80)
    && validRole(d) && validPosition(d) && d.createdAt is timestamp && d.updatedAt == request.time;
  }
  function mirror(g,u,d) {
   let i = getAfter(indexPath(g,u)).data;
   return i.uid == u && i.groupId == g && i.createdAt == d.createdAt;
  }
  function accepting(g,u) {
   let before = get(invitationPath(g,u)).data;
   let after = getAfter(invitationPath(g,u)).data;
   return owner(u) && before.status == 'pending' && after.status == 'accepted'
    && after.updatedAt == request.time && admin(g,before.inviterUid);
  }
  function assigned(g,u,d) {
   let i = get(invitationPath(g,u)).data;
   return accepting(g,u) && d.role == i.role && d.position == i.position && d.customPosition == i.customPosition;
  }
  function creator(g,u,d) {
   let group = getAfter(groupPath(g)).data;
   return owner(u) && !exists(groupPath(g)) && group.createdBy == u
    && group.administratorUid == u && d.role == 'administrator';
  }
  function validInvitation(g,u,d) {
   return d.keys().hasAll(['groupId','recipientUid','groupName','inviterUid','role','position','customPosition','notificationId','status','createdAt','updatedAt'])
    && d.keys().hasOnly(['groupId','recipientUid','groupName','inviterUid','role','position','customPosition','notificationId','status','createdAt','updatedAt'])
    && d.groupId == g && d.recipientUid == u && text(d.groupName,120) && text(d.inviterUid,128)
    && validRole(d) && validPosition(d) && d.notificationId is string && d.notificationId.matches('^[A-Za-z0-9]{20}$')
    && d.status in ['pending','accepted','declined'] && d.createdAt is timestamp && d.updatedAt == request.time;
  }
  function invite(g,u,d) {
   return complete() && admin(g,request.auth.uid) && u != request.auth.uid
    && profile(u).profileComplete == true && profile(u).allowInvitations == true
    && !exists(memberPath(g,u)) && d.status == 'pending' && d.createdAt == request.time
    && d.inviterUid == request.auth.uid && d.groupName == get(groupPath(g)).data.name;
  }
  function acceptedNotification(d) {
   let n = getAfter(/databases/$(database)/documents/profiles/$(d.inviterUid)/notifications/$(d.notificationId)).data;
   return n.groupId == d.groupId && n.recipientUid == d.recipientUid && n.groupName == d.groupName && n.createdAt == request.time;
  }
  match /profiles/{uid} {
   allow get: if owner(uid);
   allow create: if owner(uid) && validProfile(request.resource.data)
    && request.resource.data.createdAt == request.time
    && (request.resource.data.profileComplete ? request.resource.data.completedAt == request.time : request.resource.data.completedAt == null)
    && profileDirectory(request.resource.data);
   allow update: if owner(uid) && validProfile(request.resource.data)
    && request.resource.data.createdAt == resource.data.createdAt
    && (!resource.data.profileComplete || request.resource.data.profileComplete)
    && (resource.data.profileComplete ? request.resource.data.completedAt == resource.data.completedAt
      : request.resource.data.completedAt == null || request.resource.data.completedAt == request.time)
    && profileDirectory(request.resource.data);
   match /memberships/{g} {
    allow read: if owner(uid) && complete();
    allow create: if complete() && (owner(uid) || admin(g,request.auth.uid)) && validIndex(g,uid,request.resource.data);
    allow update: if false;
    allow delete: if complete() && admin(g,request.auth.uid) && !existsAfter(memberPath(g,uid));
   }
   match /invitations/{g} {
    allow get: if owner(uid) && complete() || complete() && admin(g,request.auth.uid);
    allow list: if owner(uid) && complete();
    allow create: if validInvitation(g,uid,request.resource.data) && invite(g,uid,request.resource.data);
    allow update: if validInvitation(g,uid,request.resource.data) && (
     resource.data.status != 'pending' && invite(g,uid,request.resource.data)
     || owner(uid) && complete() && resource.data.status == 'pending'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
      && (request.resource.data.status == 'declined' && !existsAfter(memberPath(g,uid))
       || request.resource.data.status == 'accepted' && accepting(g,uid)
        && existsAfter(memberPath(g,uid)) && acceptedNotification(request.resource.data)));
   }
   match /notifications/{id} {
    allow read: if owner(uid) && complete();
    allow create: if complete() && validNotification(request.resource.data)
     && request.resource.data.recipientUid == request.auth.uid
     && notificationAcceptance(uid,id,request.resource.data);
    allow update: if owner(uid) && validNotification(request.resource.data)
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']) && request.resource.data.readAt == request.time;
   }
  }
  function validIndex(g,u,d) {
   let m = getAfter(memberPath(g,u)).data;
   return d.keys().hasAll(['uid','groupId','createdAt','updatedAt']) && d.keys().hasOnly(['uid','groupId','createdAt','updatedAt'])
    && d.uid == u && d.groupId == g && d.createdAt == request.time && d.updatedAt == request.time
    && m.uid == u && m.groupId == g && m.createdAt == d.createdAt;
  }
  function validNotification(d) {
   return d.keys().hasAll(['recipientUid','groupId','groupName','createdAt','readAt'])
    && d.keys().hasOnly(['recipientUid','groupId','groupName','createdAt','readAt'])
    && text(d.recipientUid,128) && text(d.groupId,128) && text(d.groupName,120)
    && d.createdAt is timestamp && (d.readAt == null || d.readAt is timestamp);
  }
  function notificationAcceptance(uid,id,d) {
   let i = getAfter(invitationPath(d.groupId,d.recipientUid)).data;
   return accepting(d.groupId,d.recipientUid) && i.inviterUid == uid && i.notificationId == id
    && i.groupName == d.groupName && d.createdAt == request.time && d.readAt == null;
  }
  match /groups/{g} {
   allow get: if member(g);
   allow create: if complete() && validGroup(request.resource.data)
    && request.resource.data.createdBy == request.auth.uid && request.resource.data.administratorUid == request.auth.uid
    && request.resource.data.createdAt == request.time && request.resource.data.memberCount == 1
    && getAfter(memberPath(g,request.auth.uid)).data.role == 'administrator';
   allow update: if complete() && admin(g,request.auth.uid) && validGroup(request.resource.data)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['administratorUid','updatedAt']) && survivingAdmin(g);
   match /members/{uid} {
    allow read: if member(g);
    allow create: if complete() && validMember(g,uid,request.resource.data)
     && (creator(g,uid,request.resource.data) || assigned(g,uid,request.resource.data))
     && request.resource.data.firstName == profile(uid).firstName && request.resource.data.lastName == profile(uid).lastName
     && request.resource.data.createdAt == request.time && mirror(g,uid,request.resource.data) && survivingAdmin(g);
    allow update: if complete() && admin(g,request.auth.uid) && validMember(g,uid,request.resource.data)
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','position','customPosition','updatedAt'])
     && (uid != request.auth.uid || request.resource.data.role == resource.data.role || request.resource.data.role != 'administrator')
     && survivingAdmin(g);
    allow delete: if complete() && admin(g,request.auth.uid) && !existsAfter(indexPath(g,uid)) && survivingAdmin(g);
   }
  }
  // Phase 3C: songs contain 1..8 arrangements, 0..8 presets (max 2 changed arrangements/write);
  // Setlists contain 0..6 items per version. IDs are immutable. Canonical source
  // is a string, never rewritten. catalog/{arrangementId} stores songId + uses.
  // Registry transitions and their Song/Setlist writes are one atomic operation.
  function contentRead(g) { return google() && exists(groupPath(g)) && exists(memberPath(g,request.auth.uid)); }
  function contentWrite(g) { return contentRead(g) && get(memberPath(g,request.auth.uid)).data.role in ['administrator','worshipLeader']; }
  function registryPath(g,id) { return /databases/$(database)/documents/groups/$(g)/catalog/$(id); }
  function songPath(g,id) { return /databases/$(database)/documents/groups/$(g)/songs/$(id); }
  function setlistPath(g,id) { return /databases/$(database)/documents/groups/$(g)/setlists/$(id); }
  function contentText(s,n) { return s is string && s.size()>0 && s.size()<=n; }
  function contentId(id) { return id is string && id.matches('^[A-Za-z0-9-]{1,80}$'); }
  function musicKey(k) { return k is string && k.matches('^[A-G][#b♯♭]{0,2}\\s*(m|min|minor|maj|major)?$'); }
  function validArrangement(g,s,a) {
   return a.keys().hasOnly(['id','name','bpm','timeSignature','chordProSource','referenceLink'])
    && contentId(a.id) && contentText(a.name,120) && a.bpm is int && a.bpm >= 1 && a.bpm <= 400
    && a.timeSignature in ['3/4','4/4','6/8'] && a.chordProSource is string && a.chordProSource.size()>0 && a.chordProSource.size()<=200000
    && a.referenceLink is string && a.referenceLink.size()<=2048 && (a.referenceLink=='' || a.referenceLink.matches('^https?://[^/ ].*'))
    && getAfter(registryPath(g,a.id)).data.songId == s;
  }
  function songArrangementAt(g,s,d,i) {
   let keys=d.arrangementChanges;
   return keys.size()<=i || !d.arrangements.keys().hasAny([keys[i]]) || d.arrangements[keys[i]].id==keys[i] && validArrangement(g,s,d.arrangements[keys[i]]);
  }
  function presetAt(list,i) { return list.size()<=i || list[i].keys().hasOnly(['vocalistName','key']) && contentText(list[i].vocalistName,80) && musicKey(list[i].key); }
  function validSong(g,id,d) {
   let old=request.method=='update' ? resource.data.arrangements : {};
   return d.keys().hasOnly(['id','groupId','title','artist','category','isFavorite','vocalistKeys','arrangements','arrangementIds','arrangementChanges','createdAt','updatedAt'])
    && contentId(id) && d.id==id && d.groupId==g && contentText(d.title,200) && contentText(d.artist,200) && contentText(d.category,80) && d.isFavorite is bool
    && d.createdAt is timestamp && d.updatedAt==request.time && d.arrangements is map && d.arrangementIds is list && d.vocalistKeys is list
    && d.arrangementChanges is list && d.arrangementChanges.size()<=2 && d.arrangementChanges.toSet()==d.arrangements.diff(old).affectedKeys()
    && (request.method!='create' || d.vocalistKeys.size()<=4)
    && d.arrangements.size()>0 && d.arrangements.size()<=8 && d.arrangements.keys().toSet()==d.arrangementIds.toSet() && d.arrangementIds.toSet().size()==d.arrangementIds.size() && d.vocalistKeys.size()<=8
    && (d.arrangementChanges.size()<=0 || songArrangementAt(g,id,d,0) && (d.arrangementChanges.size()<=1 || songArrangementAt(g,id,d,1)))
    && (request.method=='update' && d.vocalistKeys==resource.data.vocalistKeys || (d.vocalistKeys.size()<=0 || presetAt(d.vocalistKeys,0) && (d.vocalistKeys.size()<=1 || presetAt(d.vocalistKeys,1) && (d.vocalistKeys.size()<=2 || presetAt(d.vocalistKeys,2) && (d.vocalistKeys.size()<=3 || presetAt(d.vocalistKeys,3) && (d.vocalistKeys.size()<=4 || presetAt(d.vocalistKeys,4) && (d.vocalistKeys.size()<=5 || presetAt(d.vocalistKeys,5) && (d.vocalistKeys.size()<=6 || presetAt(d.vocalistKeys,6) && (d.vocalistKeys.size()<=7 || presetAt(d.vocalistKeys,7) && true)))))))));
  }
  function releasedArrangementAt(g,list,i) { return list.size()<=i || !existsAfter(registryPath(g,list[i])); }
  function releasedSong(g,list) { return
    releasedArrangementAt(g,list,0) && releasedArrangementAt(g,list,1) && releasedArrangementAt(g,list,2) && releasedArrangementAt(g,list,3) && releasedArrangementAt(g,list,4) && releasedArrangementAt(g,list,5) && releasedArrangementAt(g,list,6) && releasedArrangementAt(g,list,7);
  }
  function validItem(g,id,item,keys) {
   let registration=getAfter(registryPath(g,item.arrangementId)).data;
   return item.keys().hasOnly(['songId','arrangementId','performanceKey','vocalistName'])
    && musicKey(item.performanceKey)
    && (item.vocalistName==null || contentText(item.vocalistName,80))
    && registration.songId==item.songId
    && registration.uses.hasAny([id]);
  }
  function versionKeys(list) { return [list.size()>0 ? list[0].arrangementId : '',list.size()>1 ? list[1].arrangementId : '',list.size()>2 ? list[2].arrangementId : '',list.size()>3 ? list[3].arrangementId : '',list.size()>4 ? list[4].arrangementId : '',list.size()>5 ? list[5].arrangementId : ''].removeAll(['']).toSet(); }
  function validItems(g,id,list,keys) { return list is list && list.size()<=6 && keys is list && keys.size()<=6 && keys.size()==keys.toSet().size() && keys.toSet()==versionKeys(list) && (list.size()<=0 || validItem(g,id,list[0],keys) && (list.size()<=1 || validItem(g,id,list[1],keys) && (list.size()<=2 || validItem(g,id,list[2],keys) && (list.size()<=3 || validItem(g,id,list[3],keys) && (list.size()<=4 || validItem(g,id,list[4],keys) && (list.size()<=5 || validItem(g,id,list[5],keys) && true)))))); }
  function validSetlist(g,id,d) {
   return d.keys().hasOnly(['id','groupId','name','serviceDateTime','status','publishedItems','draftItems','publishedKeys','draftKeys','referenceKeys','createdAt','updatedAt','revision'])
    && contentId(id) && d.id==id && d.groupId==g && contentText(d.name,120) && d.serviceDateTime is timestamp && d.status in ['draft','published']
    && d.publishedKeys is list && d.draftKeys is list && d.referenceKeys.toSet()==d.publishedKeys.toSet().union(d.draftKeys.toSet())
    && d.referenceKeys is list && d.referenceKeys.size()<=12 && d.referenceKeys.toSet().size()==d.referenceKeys.size()
    && d.createdAt is timestamp && d.updatedAt==request.time && d.revision is int && d.revision>0
    && (d.status=='published' || d.publishedItems.size()==0 && d.draftItems!=null)
    && (request.method=='update' && d.publishedItems==resource.data.publishedItems && d.publishedKeys==resource.data.publishedKeys || validItems(g,id,d.publishedItems,d.publishedKeys)) && (d.draftItems==null && d.draftKeys.size()==0 || request.method=='update' && d.draftItems==resource.data.draftItems && d.draftKeys==resource.data.draftKeys || validItems(g,id,d.draftItems,d.draftKeys));
  }
  function validCatalog(g,id,d) {
   return d.keys().hasOnly(['songId','uses','target','updatedAt']) && contentId(id) && contentId(d.songId) && contentId(d.target)
    && d.uses is list && d.updatedAt==request.time;
  }
  function catalogReferences(g,id,d) {
   let path=setlistPath(g,d.target);
   let refs=existsAfter(path) ? getAfter(path).data.referenceKeys : [];
   return d.songId==resource.data.songId && d.uses.toSet()==resource.data.uses.toSet().difference([d.target].toSet()).union(refs.hasAny([id])?[d.target].toSet():[].toSet());
  }
  match /groups/{g}/songs/{id} {
   allow read: if contentRead(g);
   allow create: if contentWrite(g) && validSong(g,id,request.resource.data) && request.resource.data.createdAt==request.time;
   allow update: if contentWrite(g) && validSong(g,id,request.resource.data) && request.resource.data.createdAt==resource.data.createdAt
    && (request.resource.data.arrangementIds.toSet().hasAll(resource.data.arrangementIds) || removedSongArrangements(g,resource.data.arrangementIds,request.resource.data.arrangementIds));
   allow delete: if contentWrite(g) && releasedSong(g,resource.data.arrangementIds);
  }
  function removedArrangementAt(g,old,next,i) { return old.size()<=i || next.hasAny([old[i]]) || !existsAfter(registryPath(g,old[i])); }
  function removedSongArrangements(g,old,next) { return
    removedArrangementAt(g,old,next,0) && removedArrangementAt(g,old,next,1) && removedArrangementAt(g,old,next,2) && removedArrangementAt(g,old,next,3) && removedArrangementAt(g,old,next,4) && removedArrangementAt(g,old,next,5) && removedArrangementAt(g,old,next,6) && removedArrangementAt(g,old,next,7);
  }
  match /groups/{g}/setlists/{id} {
   allow read: if contentRead(g);
   allow create: if contentWrite(g) && validSetlist(g,id,request.resource.data) && request.resource.data.createdAt==request.time && request.resource.data.revision==1;
   allow update: if contentWrite(g) && validSetlist(g,id,request.resource.data) && request.resource.data.createdAt==resource.data.createdAt && request.resource.data.revision==resource.data.revision+1;
   allow delete: if contentWrite(g);
  }
  match /groups/{g}/catalog/{id} {
   allow get: if contentRead(g);
   allow create: if contentWrite(g) && validCatalog(g,id,request.resource.data)
    && request.resource.data.uses.size()==0
    && getAfter(songPath(g,request.resource.data.songId)).data.arrangementIds.hasAny([id]);
   allow update: if contentWrite(g) && validCatalog(g,id,request.resource.data) && catalogReferences(g,id,request.resource.data);
   allow delete: if contentWrite(g) && resource.data.uses.size()==0
    && (!existsAfter(songPath(g,resource.data.songId)) || !getAfter(songPath(g,resource.data.songId)).data.arrangementIds.hasAny([id]));
  }
  match /directoryAccess/{uid} {
   allow get: if owner(uid);
   allow create, update: if owner(uid) && complete() && validLookupContext(uid,request.resource.data);
  }
  match /emailDirectory/{email} {
   // Exact lookup only; even an admin cannot list/query the directory.
   allow get: if complete() && (email == request.auth.token.email.lower()
    || admin(get(/databases/$(database)/documents/directoryAccess/$(request.auth.uid)).data.groupId,request.auth.uid))
    && (!exists(/databases/$(database)/documents/emailDirectory/$(email))
     || profile(resource.data.uid).allowInvitations == true && profile(resource.data.uid).email.lower() == email);
   allow create, update: if google() && email == request.auth.token.email.lower()
    && validDirectory(request.auth.uid,request.resource.data)
    && directoryMatches(request.auth.uid,request.resource.data);
   allow delete: if google() && email == request.auth.token.email.lower()
    && resource.data.uid == request.auth.uid && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.allowInvitations == false;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
